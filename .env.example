# Copy to .env next to docker-compose.yml and adjust.

# Name of the Fail2ban container (docker ps). The socket proxy only allows this one container.
FAIL2BAN_CONTAINER=fail2ban

# Fail2ban's configuration folder on the host (the one mounted as /data in the crazymax/fail2ban container)
FAIL2BAN_DATA=/srv/fail2ban/data

# Group id of the Docker socket on the host, so the proxy can read it without running as root:
#   getent group docker | cut -d: -f3      (or: stat -c %g /var/run/docker.sock)
DOCKER_GID=999
