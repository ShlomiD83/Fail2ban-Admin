# Copy to .env next to docker-compose.yml and adjust.

# Name of the Fail2ban container (docker ps). The socket proxy only allows this one container.
FAIL2BAN_CONTAINER=fail2ban

# Fail2ban's configuration folder on the host (the one mounted as /data in the crazymax/fail2ban container)
FAIL2BAN_DATA=/srv/fail2ban/data

# Group id of the Docker socket on the host, so the proxy can read it without running as root:
#   stat -c %g /var/run/docker.sock      (the socket's own group; 0 if it belongs to root:root)
DOCKER_GID=999

# User and group the panel runs as. They must be able to write FAIL2BAN_DATA's jail.d, filter.d and action.d
# folders (and ./admin). Check with:  ls -ldn "$FAIL2BAN_DATA"/jail.d "$FAIL2BAN_DATA"/filter.d "$FAIL2BAN_DATA"/action.d
#  - folders writable by a group (drwxrwsr-x root 100): your user id (id -u) and that group, e.g. 1000 and 100
#  - folders owned by your user: your user id and group (id -u, id -g)
#  - folders only root may write (drwxr-xr-x root root): give them to a group, e.g. users (100):
#      cd "$FAIL2BAN_DATA" && sudo chgrp 100 jail.d filter.d action.d && sudo chmod 2775 jail.d filter.d action.d
#    or leave these two lines out to run as root
# Also give the panel's own folder to that user:  mkdir -p admin && sudo chown PUID:PGID admin
PUID=1000
PGID=100
